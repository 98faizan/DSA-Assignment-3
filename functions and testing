void deleteByRollNo(int rollNo)
{
    if (head == NULL)
    {
        cout << "List is empty!\n";
        return;
    }

    if (head->rollNo == rollNo)
    {
        Node* temp = head;
        head = head->next;
        delete temp;

        cout << "Student deleted successfully!\n";
        return;
    }

    Node* current = head;
    Node* previous = NULL;

    while (current != NULL && current->rollNo != rollNo)
    {
        previous = current;
        current = current->next;
    }

    if (current == NULL)
    {
        cout << "Student not found!\n";
        return;
    }

    previous->next = current->next;
    delete current;

    cout << "Student deleted successfully!\n";
}

void searchStudent(int rollNo)
{
    Node* temp = head;

    while (temp != NULL)
    {
        if (temp->rollNo == rollNo)
        {
            cout << "\nStudent Found:\n";
            cout << "Roll No: " << temp->rollNo << endl;
            cout << "Name: " << temp->name << endl;
            return;
        }

        temp = temp->next;
    }

    cout << "Student not found!\n";
}

void countStudents()
{
    int count = 0;
    Node* temp = head;

    while (temp != NULL)
    {
        count++;
        temp = temp->next;
    }

    cout << "\nTotal Students: " << count << endl;
}
